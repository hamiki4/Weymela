# TEMPLATE ONLY. Do not place credentials in this file or commit a populated copy.
# Environment variables use double underscores for .NET configuration sections.
ASPNETCORE_ENVIRONMENT=Pilot
DOTNET_ENVIRONMENT=Pilot
ConnectionStrings__WeymelaV3=
V3__EnableDevelopmentIdentity=false
V3__Auth__Provider=Firebase
V3__Auth__FirebaseProjectId=
# Public Web build values only; never put service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=weymela-pilot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=weymela-pilot
VITE_FIREBASE_APP_ID=
# Email-code verification uses the registered email; phone is an unverified
# secondary identifier. No SMS/Phone OTP or service-account credential is used.
V3__Auth__EmailDeliveryMode=Disabled
V3__Auth__FirebaseCustomTokenMode=Disabled
V3__Auth__CodeHashKey=
V3__Auth__CookieKeyDirectory=/run/weymela-v3/keys
V3__Auth__CookieCertificatePath=/run/secrets/v3-cookie-protection.pfx
V3__Auth__CookieCertificatePassword=
V3__AllowedOrigins__0=
V3__PublicWebUrl=
V3__PublicApiUrl=
V3__ProductIntegration__Enabled=false
V3__ProductIntegration__Issuer=
V3__ProductIntegration__Audience=
V3__ProductIntegration__Environment=Pilot
V3__ProductIntegration__CallbackId=
V3__ProductIntegration__CallbackUrl=
V3__ProductIntegration__BeginUrl=
V3__ProductIntegration__ProductWebUrl=
V3__ProductIntegration__ClientId=
V3__ProductIntegration__ClientSecret=
V3__Security__CameraPolicy=camera=(self), microphone=(), geolocation=(), payment=(), usb=()
V3__Security__TlsEdgeConfirmed=false
V3__Security__TrustedProxies__0=
V3__FinancialWritesEnabled=false
V3__Deposits__Mode=Disabled
V3__Social__Mode=Disabled
V3__Push__Enabled=false
V3__Worker__Enabled=true
V3__Worker__BatchSize=20
V3__Worker__RecipientBatchSize=100
V3__Worker__IntervalSeconds=5
# Do not source this template as shell code; use deployment-owned protected configuration.
