ARG NODE_IMAGE
ARG WEB_IMAGE
FROM ${NODE_IMAGE} AS build
WORKDIR /source
COPY src/Weymela.Web/package.json src/Weymela.Web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/Weymela.Web/ ./
RUN npm run build

FROM ${WEB_IMAGE} AS runtime
# Alpine 3.24 / linux-amd64: targeted libuuid security fix, not a general upgrade.
# Verify fixed package bytes, then require Alpine's normal signature/dependency
# checks offline. No repository refresh can introduce unrelated package upgrades.
RUN wget -O /tmp/weymela-libuuid-2.42.3-r1.apk \
      https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/libuuid-2.42.3-r1.apk \
    && printf '%s  %s\n' 8306e5bb577696c9069fe1dfd9e1dcc39d2d481c6a1b0e707fd03c3e21aa6aa2 /tmp/weymela-libuuid-2.42.3-r1.apk | sha256sum -c - \
    && apk add --no-cache --no-network /tmp/weymela-libuuid-2.42.3-r1.apk \
    && apk info --installed 'libuuid=2.42.3-r1' \
    && rm /tmp/weymela-libuuid-2.42.3-r1.apk
COPY docker/web/nginx.conf /etc/nginx/nginx.conf
COPY docker/web/security-headers.conf /etc/nginx/v3-security-headers.conf
COPY --from=build --chown=101:101 /source/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health/live || exit 1
ENTRYPOINT ["nginx", "-g", "daemon off;"]
