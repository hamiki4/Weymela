ARG NODE_IMAGE
ARG WEB_IMAGE
FROM ${NODE_IMAGE} AS build
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_APP_ID
ARG V3_SOURCE_COMMIT
ARG V3_FRONTEND_SOURCE_FINGERPRINT
ENV VITE_FIREBASE_API_KEY=${VITE_FIREBASE_API_KEY} \
    VITE_FIREBASE_AUTH_DOMAIN=${VITE_FIREBASE_AUTH_DOMAIN} \
    VITE_FIREBASE_PROJECT_ID=${VITE_FIREBASE_PROJECT_ID} \
    VITE_FIREBASE_APP_ID=${VITE_FIREBASE_APP_ID}
WORKDIR /source
RUN test -n "$V3_SOURCE_COMMIT" \
    && test -n "$V3_FRONTEND_SOURCE_FINGERPRINT" \
    && printf '%s\n' "$V3_FRONTEND_SOURCE_FINGERPRINT" > /tmp/weymela-frontend-source-fingerprint
COPY src/Weymela.Web/package.json src/Weymela.Web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/Weymela.Web/ ./
RUN test -n "$VITE_FIREBASE_API_KEY" \
    && test -n "$VITE_FIREBASE_AUTH_DOMAIN" \
    && test "$VITE_FIREBASE_PROJECT_ID" = "weymela-pilot" \
    && test -n "$VITE_FIREBASE_APP_ID" \
    && test "$(cat /tmp/weymela-frontend-source-fingerprint)" = "$V3_FRONTEND_SOURCE_FINGERPRINT" \
    && npm run build \
    && printf '{"commit":"%s","frontendSourceFingerprint":"%s"}\n' \
      "$V3_SOURCE_COMMIT" "$V3_FRONTEND_SOURCE_FINGERPRINT" > dist/build-identity.json \
    && printf '{"firebaseProjectId":"%s"}\n' "$VITE_FIREBASE_PROJECT_ID" > dist/firebase-build.json

FROM ${WEB_IMAGE} AS runtime
# Alpine 3.24 / linux-amd64: targeted libuuid security fix, not a general upgrade.
# Verify fixed package bytes, then require Alpine's normal signature/dependency
# checks offline. No repository refresh can introduce unrelated package upgrades.
RUN wget -O /tmp/weymela-libuuid-2.42.3-r1.apk \
      https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/libuuid-2.42.3-r1.apk \
    && printf '%s  %s\n' 8306e5bb577696c9069fe1dfd9e1dcc39d2d481c6a1b0e707fd03c3e21aa6aa2 /tmp/weymela-libuuid-2.42.3-r1.apk | sha256sum -c - \
    && apk add --no-cache --no-network /tmp/weymela-libuuid-2.42.3-r1.apk \
    && apk info --installed 'libuuid=2.42.3-r1' \
    && rm /tmp/weymela-libuuid-2.42.3-r1.apk
COPY docker/web/nginx.conf /etc/nginx/nginx.conf
COPY docker/web/security-headers.conf /etc/nginx/weymela-security-headers.conf
COPY --from=build --chown=101:101 /source/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health/live || exit 1
ENTRYPOINT ["nginx", "-g", "daemon off;"]
