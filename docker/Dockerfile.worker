ARG SDK_IMAGE
ARG RUNTIME_IMAGE
FROM ${SDK_IMAGE} AS build
WORKDIR /source
COPY src/Weymela.Domain/ src/Weymela.Domain/
COPY src/Weymela.Application/ src/Weymela.Application/
COPY src/Weymela.Infrastructure/ src/Weymela.Infrastructure/
COPY src/Weymela.Worker/ src/Weymela.Worker/
RUN dotnet publish src/Weymela.Worker/Weymela.Worker.csproj -c Release -o /out --nologo -p:UseAppHost=false

# Worker currently references Microsoft.AspNetCore.App; runtime-only is insufficient.
FROM ${RUNTIME_IMAGE} AS runtime
USER root
# USN-8847-1: the current Microsoft Noble base still carries OpenSSL .15.
# Use only its signed Ubuntu repositories; pin the two security-fixed packages.
RUN apt-get update && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && apt-get install -y --no-install-recommends --only-upgrade \
        openssl=3.0.13-0ubuntu3.16 libssl3t64=3.0.13-0ubuntu3.16 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=1654:1654 /out/ ./
ENV DOTNET_EnableDiagnostics=0
USER 1654:1654
HEALTHCHECK --interval=30s --timeout=8s --start-period=60s --retries=3 CMD ["/bin/sh", "/app/worker-healthcheck.sh"]
ENTRYPOINT ["dotnet", "Weymela.Worker.dll"]
