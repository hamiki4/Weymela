# TEMPLATE ONLY. Populate outside repository, mode 0600, never log expanded config.
ASPNETCORE_ENVIRONMENT=Pilot
DOTNET_ENVIRONMENT=Pilot
# Host=weymela-v3-pilot-postgres;Database=weymela_v3_pilot;Username=weymela_v3_api;Password=EXTERNAL;Maximum Pool Size=20
ConnectionStrings__WeymelaV3=
V3__EnableDevelopmentIdentity=false
V3__Auth__Provider=Firebase
V3__Auth__FirebaseProjectId=weymela-pilot
# Authentication adapters are Pilot-only in this template. Never substitute Production credentials.
V3__Auth__EmailDeliveryMode=Resend
V3__Auth__ResendApiKey=
V3__Auth__ResendFromAddress=no-reply@pilot-mail.weymela.com
V3__Auth__ResendFromName=Weymela Pilot
V3__Auth__FirebaseCustomTokenMode=FirebaseAdmin
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/v3-firebase-admin.json
# Independent, strict base64-encoded 32+ random bytes. Never reuse the PIN pepper.
V3__Auth__CodeHashKey=
# Independently generated strict base64-encoded 32+ random bytes.
V3__Auth__PinPepper=
V3__Auth__CookieKeyDirectory=/run/weymela-v3/keys
V3__Auth__CookieCertificatePath=/run/secrets/v3-cookie-protection.pfx
V3__Auth__CookieCertificatePassword=
V3__AllowedOrigins__0=https://v3-pilot.weymela.com
V3__PublicWebUrl=https://v3-pilot.weymela.com
V3__PublicApiUrl=https://api-v3-pilot.weymela.com
# Disabled until the separately authorized V2-derived integration Pilot exists.
V3__ProductIntegration__Enabled=false
V3__ProductIntegration__Issuer=
V3__ProductIntegration__Audience=
V3__ProductIntegration__Environment=Pilot
V3__ProductIntegration__CallbackId=
V3__ProductIntegration__CallbackUrl=
V3__ProductIntegration__BeginUrl=
V3__ProductIntegration__ProductWebUrl=
V3__ProductIntegration__ClientId=
V3__ProductIntegration__ClientSecret=
V3__Security__CameraPolicy="camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
V3__Security__TlsEdgeConfirmed=false
V3__FinancialWritesEnabled=false
V3__Deposits__Mode=ManualApproval
V3__Social__Mode=Disabled
V3__Push__Enabled=false
V3__Worker__Enabled=true
V3__Worker__BatchSize=20
V3__Worker__RecipientBatchSize=100
V3__Worker__IntervalSeconds=5
V3__RateLimitMultiplier=1
# Retention is preserve-only in Phase 6: no purge configuration/job exists.
# Set TLS confirmation only AFTER real edge checks. Compose fixes financial freeze ON.
